company-vendor-examine = A {$company} franchise machine with a [color=yellow]level {$level}[/color] stock module: [color=yellow]{$stock}/{$capacity}[/color] items left.
company-vendor-examine-empty = [color=red]It is sold out. The company has to bring a new stock module.[/color]
company-vendor-restock-examine = A {$company} stock module, [color=yellow]level {$level}[/color]. It replaces a machine's stock with a full load, or takes over a rival company's machine.

company-vendor-restock-start = You start swapping the stock module in {THE($machine)}.
company-vendor-takeover-start = You start refitting {THE($machine)} for your company.
company-vendor-restock-done = {CAPITALIZE(THE($machine))} is restocked: level {$level}, {$capacity} items.
company-vendor-takeover-done = {CAPITALIZE(THE($machine))} now runs your company's franchise: level {$level}, {$capacity} items.

company-vendor-wrong-product = {CAPITALIZE(THE($module))} does not fit {THE($machine)}.
company-vendor-not-member = Only {$company} staff can install this module.
company-vendor-no-agreement = {$host} has no trade agreement with {$company}. The machine refuses the module.
